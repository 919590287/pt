# 复制为 .env 后按机器实际情况修改：cp docker.env.example .env
# docker compose 默认读取同目录的 .env，无需额外指定。

# ============================================================
# 镜像
# ============================================================
# 用镜像仓库时填仓库前缀，例如：
#   IMAGE_PREFIX=registry.cn-guangzhou.aliyuncs.com/你的命名空间
# 在服务器本地构建时保持默认即可
IMAGE_PREFIX=gjcxfzksh
IMAGE_TAG=latest

# 构建加速源（仅构建镜像时生效，服务器只拉取镜像的话用不到）
MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public
NPM_REGISTRY=https://registry.npmmirror.com

# ============================================================
# 宿主机数据目录（必填，没有默认值）
# ============================================================
PT_DATA_DIR=/data/pt_data
PT_CACHE_DIR=/data/pt_cache
GEO_DIR=/data/geo

# 后端容器内运行 Java 的用户。data-permissions 初始化容器每次启动会把
# PT_DATA_DIR / PT_CACHE_DIR 下属主不符的文件 chown 成这一对 uid:gid，
# 这样从开发机 rsync 上来的数据（会带着 macOS 的 uid 501 和 700 权限）不必手工修。
# 改了这里必须重新 build 后端镜像，镜像里的 app 用户是构建期 useradd 出来的。
APP_UID=10001
APP_GID=10001

# ============================================================
# 对外访问
# ============================================================
HTTP_BIND=0.0.0.0
HTTP_PORT=8090
# 前后端同源，保持 "/" 即可；除非把后端放在了另一个域名下
APP_API_BASE_URL=/
# 浏览器的 POST 请求即使经过同源 Nginx，也会携带 Origin。
# 必须填写浏览器地址（协议 + IP/域名 + 端口），否则登录、注册会被后端以 403 拒绝。
# 多个地址用英文逗号分隔；下面是当前云服务器的实际访问地址。
CORS_ALLOWED_ORIGINS=http://8.134.88.9:8090

# ============================================================
# 内存（按 32G 内存的机器给的值）
# 约束：BACKEND_MEM_LIMIT >= 主进程 BACKEND_HEAP + CACHE_BUILDER_XMX + 2g 原生/页缓存余量
# ============================================================
BACKEND_HEAP=2g
MATSIM_CACHE_BUILDER_XMX=6g
OPTIMIZATION_RUNNER_XMX=8g
BACKEND_MEM_LIMIT=10g

# ============================================================
# 性能调优
# ============================================================
# 缓存后台构建并发。服务器 SSD 可以用 2，机械盘/网络盘用 1
MATSIM_CACHE_BUILD_THREADS=1
# 仅临时 Builder 使用的单模型内部并行度；主进程不会因此常驻创建线程。
MATSIM_PROCESSING_THREADS=4
MATSIM_TRAJECTORY_BUILD_THREADS=1
MATSIM_TRAJECTORY_QUERY_CONCURRENCY=2
MATSIM_RUNTIME_MAX_COMPUTE_MODELS=1
MATSIM_RUNTIME_MAX_VISUAL_MODELS=1
MATSIM_CACHE_BUILDER_ISOLATED_ENABLED=true
MATSIM_CACHE_BUILDER_XMS=256m
MATSIM_CACHE_BUILDER_MAX_METASPACE=512m
BACKEND_MEMORY_CACHE_MAX_BYTES=268435456
UNDERTOW_WORKER_THREADS=32
UNDERTOW_IO_THREADS=4
# 线网优化并发任务数。每个任务会顺序跑两个 MATSim，调大前先确认内存
OPTIMIZATION_RUN_CONCURRENCY=1
# 大 events 并行解压线程数
GJCXFZKSH_EVENTS_PIGZ_THREADS=4

# ============================================================
# 大模型判定阈值（沿用本机口径，不要随意改，改了会影响加载模式和统计口径）
# ============================================================
MATSIM_LARGE_MODEL_THRESHOLD_BYTES=21474836480
MATSIM_LARGE_MODEL_PLANS_THRESHOLD_BYTES=8589934592
MATSIM_LARGE_MODEL_EVENTS_THRESHOLD_BYTES=8589934592
MATSIM_CACHE_MIN_FREE_BYTES=21474836480
MATSIM_REAL_PASSENGER_CACHE_PREBUILD_ON_STARTUP=false
MATSIM_REAL_PASSENGER_AGGREGATE_BUILDER_ENABLED=true
MATSIM_REAL_PASSENGER_PYTHON_COMMAND=python3

# ============================================================
# 地图（留空即用代码内默认值：CARTO Positron 在线瓦片）
# ============================================================
APP_MAP_TILE_URL_TEMPLATE=
APP_MAP_BASEMAP_DEFAULT=esri-dark
APP_NETWORK_LINE_MIN_PIXELS=0.8
APP_NETWORK_LINE_SOFT_EDGE_PIXELS=0.75
APP_MAP_PIXEL_RATIO=
APP_MAP_DISPLAY_SCALE=

# 建筑物 shp 在 backend 容器内的路径（GEO_DIR 挂载到 /data/geo）
APP_CITY_BUILDINGS_SHP_PATH=/data/geo/buildings/Buildingguagnzhou84.shp
APP_CITY_BUILDINGS_ENABLED=true
APP_CITY_BUILDINGS_HEIGHT_FIELD=HEIGHT
APP_CITY_BUILDINGS_MAX_FEATURES=20000
