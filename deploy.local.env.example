# Copy this file to deploy.local.env and adjust it on each computer.

# Ports.
BACKEND_PORT=8090
FRONTEND_PORT=8088
HOST=0.0.0.0

# Backend MATSim data root. Expected layout:
#   MATSIM_DATA/area-name/model-name/input
#   MATSIM_DATA/area-name/model-name/output
MATSIM_DATA="/Volumes/USB DISK/pt_data/"

# Backend generated cache root. Keep this outside MATSIM_DATA/output and do not commit it.
MATSIM_CACHE="/Volumes/USB DISK/pt_cache/"
MATSIM_REAL_PASSENGER_SERVICE_DATE_START="2026-07-01"
MATSIM_REAL_PASSENGER_SERVICE_DATE_END="2026-07-15"
# 大模型判定：总 output 20GiB，或 plans/events 任一达到 8GiB。desc.json 可用 largeModel=true 强制开启。
MATSIM_LARGE_MODEL_THRESHOLD_BYTES=21474836480
MATSIM_LARGE_MODEL_PLANS_THRESHOLD_BYTES=8589934592
MATSIM_LARGE_MODEL_EVENTS_THRESHOLD_BYTES=8589934592
# Background cache build concurrency. 0 means auto; use 1 for safest IO, 2-4 for stronger servers.
MATSIM_CACHE_BUILD_THREADS=1
# Per-model CPU parallelism. 0 means logical cores - 1 (capped at 32); use 2-4 on low-memory machines.
# This is also the automatic upper bound used by coordinate transforms and large-events workers.
MATSIM_PROCESSING_THREADS=4
MATSIM_TRAJECTORY_QUERY_CONCURRENCY=2
# Cache readiness polling snapshot TTL; avoids repeatedly scanning an external disk.
MATSIM_CACHE_STATUS_PROBE_TTL_MS=10000
MATSIM_CACHE_PREBUILD_ON_STARTUP=false
MATSIM_REAL_PASSENGER_CACHE_PREBUILD_ON_STARTUP=false
MATSIM_REAL_PASSENGER_AGGREGATE_BUILDER_ENABLED=true
MATSIM_REAL_PASSENGER_PYTHON_COMMAND=python3
MATSIM_CACHE_MIN_FREE_BYTES=21474836480
MATSIM_CACHE_CONTENT_ADDRESSING_ENABLED=true
MATSIM_CACHE_CONTENT_ADDRESSING_MIN_BYTES=65536
MATSIM_RUNTIME_MAX_COMPUTE_MODELS=1
MATSIM_RUNTIME_MAX_VISUAL_MODELS=1
MATSIM_CACHE_BUILDER_ISOLATED_ENABLED=true
MATSIM_CACHE_BUILDER_XMS=256m
MATSIM_CACHE_BUILDER_XMX=6g
MATSIM_CACHE_BUILDER_MAX_METASPACE=512m
BACKEND_MEMORY_CACHE_MAX_BYTES=268435456
UNDERTOW_WORKER_THREADS=32
UNDERTOW_IO_THREADS=4
MATSIM_CACHE_CLEAN_OLD_VERSIONS=true

# JVM memory options for backend.
JAVA_OPTS="-Xms128m -Xmx2g -Xss768k -XX:SoftMaxHeapSize=768m -XX:+UseG1GC -XX:+UseStringDeduplication -XX:G1PeriodicGCInterval=300000 -XX:G1PeriodicGCSystemLoadThreshold=0 -XX:+ExplicitGCInvokesConcurrent -XX:MaxMetaspaceSize=256m -XX:ReservedCodeCacheSize=128m"

# Allowed CORS origins (comma separated origin patterns), e.g. "http://172.20.1.5:8088,https://bus.example.com".
# Empty means the built-in whitelist: localhost + 127.0.0.1 + 192.168.* + 10.* (any port).
CORS_ALLOWED_ORIGINS=""

# Large events acceleration. Empty means auto defaults.
# Requires pigz on server for parallel gzip decompression; without pigz Java fallback is used.
GJCXFZKSH_EVENTS_WORKERS=""
GJCXFZKSH_EVENTS_PIGZ_THREADS=""
GJCXFZKSH_EVENTS_PIGZ_ENABLED=""

# Optional absolute command paths, useful for macOS autostart.
# JAVA_HOME="/path/to/jdk-21"
# JAVA_CMD="$JAVA_HOME/bin/java"
JAVA_CMD=java
MVN_CMD=mvn
NPM_CMD=npm
NODE_CMD=node

# Optional frontend static asset paths.
# VEHICLE_MODELS_PATH should point to a directory served as /models,
# usually containing vehicles/*.glb.
VEHICLE_MODELS_PATH=""
VEHICLE_MODELS_BASE_URL="/models/vehicles"

# Optional city/building model and map configuration.
CITY_BUILDINGS_SHP_PATH=""
CITY_BUILDINGS_STATIC_PATH=""
CITY_BUILDINGS_ENABLED=true
CITY_BUILDINGS_HEIGHT_FIELD=HEIGHT
CITY_BUILDINGS_MAX_FEATURES=20000
MAP_TILE_URL_TEMPLATE=""
MAP_BASEMAP_DEFAULT=esri-dark
NETWORK_LINE_MIN_PIXELS=0.8
NETWORK_LINE_SOFT_EDGE_PIXELS=0
MAP_PIXEL_RATIO=""

# Dependency install during build: auto, 1, or 0.
FRONTEND_INSTALL=auto
