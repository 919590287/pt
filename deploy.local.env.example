# Copy this file to deploy.local.env and adjust it on each computer.

# Ports.
BACKEND_PORT=8090
FRONTEND_PORT=8088
HOST=0.0.0.0

# Backend MATSim data root. Expected layout:
#   MATSIM_DATA/area-name/model-name/input
#   MATSIM_DATA/area-name/model-name/output
MATSIM_DATA="/Volumes/USB DISK/pt_data/"

# JVM memory options for backend.
JAVA_OPTS="-Xms2g -Xmx8g"

# Optional absolute command paths, useful for macOS autostart.
JAVA_CMD=java
MVN_CMD=mvn
NPM_CMD=npm

# Optional frontend static asset paths.
# VEHICLE_MODELS_PATH should point to a directory served as /models,
# usually containing vehicles/*.glb.
VEHICLE_MODELS_PATH=""
VEHICLE_MODELS_BASE_URL="/models/vehicles"

# Optional city/building model and map configuration.
CITY_BUILDINGS_SHP_PATH=""
CITY_BUILDINGS_STATIC_PATH=""
CITY_BUILDINGS_ENABLED=true
CITY_BUILDINGS_HEIGHT_FIELD=HEIGHT
CITY_BUILDINGS_MAX_FEATURES=20000
MAP_TILE_URL_TEMPLATE=""
NETWORK_LINE_MIN_PIXELS=0.8
NETWORK_LINE_SOFT_EDGE_PIXELS=0.75
MAP_PIXEL_RATIO=""

# Dependency install during build: auto, 1, or 0.
FRONTEND_INSTALL=auto
